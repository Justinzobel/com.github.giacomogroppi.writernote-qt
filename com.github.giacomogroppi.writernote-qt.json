{
  "app-id": "com.github.giacomogroppi.writernote-qt",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.9",
  "sdk": "org.kde.Sdk",
  "command": "writernote",
  "finish-args": [
    "--device=dri",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--share=ipc"
  ],
  "cleanup": [
    "/lib/pkgconfig",
    "/share/man",
   "/include",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "Libzip",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "cleanup": [
        "/bin"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/nih-at/libzip.git",
          "tag": "v1.8.0",
          "commit": "26ba5523db09213f532821875542dba7afa04b65"
        }
      ]
    },
    {
      "name": "poppler",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
        "-DBUILD_GTK_TESTS=OFF",
        "-DBUILD_QT5_TESTS=OFF",
        "-DBUILD_QT6_TESTS=OFF",
        "-DBUILD_CPP_TESTS=OFF",
        "-DENABLE_UTILS=OFF",
        "-DENABLE_CPP=OFF",
        "-DENABLE_GLIB=OFF",
        "-DENABLE_QT5=OFF",
        "-DENABLE_QT6=ON"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://poppler.freedesktop.org/poppler-25.06.0.tar.xz",
          "sha256": "8199532d38984fab46dbd0020ec9c40f20e928e33e9b4cc6043572603a821d83",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 3686,
            "stable-only": true,
            "url-template": "https://poppler.freedesktop.org/poppler-$version.tar.xz"
          }
        }
      ]
    },
    {
      "name": "writernote",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DFLATPAK_BUILD=ON",
        "-DVERSION_SNAPCRAFT=4.0.5h"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/giacomogroppi/writernote-qt",
          "commit": "a80c37434129031d65410aaa033c6549d0798daa"
        }
      ]
    }
  ]
}
